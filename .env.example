# Kopiraj ovaj fajl u .env i popuni. .env se NE salje na GitHub.

# Telegram (vidi uputstvo na vrhu telegram_podesi.py)
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Ukupan ulog za koji se racuna raspodela u porukama
ULOG=1000
# Na koliko minuta se povlace kvote (danju)
INTERVAL_MIN=5
# Nocu (od NOC_OD do NOC_DO) rede - kvote se retko menjaju
INTERVAL_NOC_MIN=15
NOC_OD=01:00
NOC_DO=07:00
# Kad stize jutarnji izvestaj
JUTARNJI_IZVESTAJ=07:00
# Simulacija: koliko se "uplati" na svaku nadjenu arbitrazu (zamisljeni novac)
SIM_ULOG=100000
